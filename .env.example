APP_ENV=development

BACKEND_PORT=8010
FRONTEND_PORT=5173

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=55432
POSTGRES_DB=project_cost_hub
POSTGRES_TEST_DB=project_cost_hub_test
POSTGRES_USER=project_cost
POSTGRES_PASSWORD=change_me

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_me

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEBUG=false

# Resource credentials are disabled unless explicitly enabled. Generate a key with:
#   python backend/scripts/generate_credential_master_key.py
# Store the generated value only in a local secret environment; never commit it.
RESOURCE_CREDENTIALS_ENABLED=false
CREDENTIAL_MASTER_KEY=
CREDENTIAL_ACTIVE_KEY_ID=

DEMO_BOSS_USERNAME=boss
DEMO_BOSS_PASSWORD=change_me
DEMO_PM_USERNAME=pm
DEMO_PM_PASSWORD=change_me
DEMO_MEMBER_USERNAME=member
DEMO_MEMBER_PASSWORD=change_me

# development/test: leave unset so bootstrap still creates boss/pm/member.
# production/pilot: set false (or leave unset while APP_ENV=production).
# BOOTSTRAP_DEMO_ACCOUNTS=false
